# ============================================================
# BECUGRAM ENVIRONMENT CONFIGURATION
# ============================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Client Frontend URL (CORS allowlist)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/becugram?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/becugram

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=becugram_jwt_access_secret_key_min_32_chars_long_2026
JWT_REFRESH_SECRET=becugram_jwt_refresh_secret_key_min_32_chars_long_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Eskiz.uz SMS Gateway
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Developer & Testing Mode
ENABLE_DEV_OTP_AUTOFILL=true

# Storage Provider: 'local' (default) or 's3' / 'spaces'
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=25

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
